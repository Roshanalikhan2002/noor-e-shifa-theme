              <img src="{{ image | img_url: '150x150', crop: 'center' }}" alt="{{ image.alt | escape }}">
            </button>
          {% endfor %}
        {% else %}
          <div class="thumb active" aria-hidden="true"></div>
          <div class="thumb" aria-hidden="true"></div>
          <div class="thumb" aria-hidden="true"></div>
          <div class="thumb" aria-hidden="true"></div>
          <div class="thumb" aria-hidden="true"></div>
