<script>

    (function () {
      document.querySelectorAll('#oxyAccordion .acc-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var item = btn.parentElement;
          var open = item.classList.contains('open');
          document.querySelectorAll('#oxyAccordion .acc-item').forEach(function (el) {
            el.classList.remove('open');
          });
          if (!open) item.classList.add('open');
        });
      });

      document.querySelectorAll('#oxyFaq .faq-q').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var item = btn.parentElement;
          var open = item.classList.contains('open');
          document.querySelectorAll('#oxyFaq .faq-item').forEach(function (el) {
            el.classList.remove('open');
          });
          if (!open) item.classList.add('open');
        });
      });

      var track = document.getElementById('reviewsTrack');
      var cards = track ? track.querySelectorAll('.review-card') : [];
      var dotsWrap = document.getElementById('reviewDots');
      var index = 0;
      var isMobile = function () { return window.matchMedia('(max-width: 900px)').matches; };

      function buildDots() {
        if (!dotsWrap) return;
        dotsWrap.innerHTML = '';
        var count = isMobile() ? cards.length : Math.max(1, cards.length - 2);
        for (var i = 0; i < count; i++) {
          var b = document.createElement('button');
          b.type = 'button';
          b.className = 'review-dot' + (i === 0 ? ' active' : '');
          b.setAttribute('aria-label', 'Go to review ' + (i + 1));
          (function (n) {
            b.addEventListener('click', function () { goTo(n); });
          })(i);
          dotsWrap.appendChild(b);
        }
      }

      function goTo(n) {
        if (!track || !cards.length) return;
        var max = isMobile() ? cards.length - 1 : Math.max(0, cards.length - 3);
        index = Math.max(0, Math.min(n, max));
        var cardWidth = cards[0].getBoundingClientRect().width;
        var gap = isMobile() ? 0 : 22;
        track.style.transform = 'translateX(-' + (index * (cardWidth + gap)) + 'px)';
        cards.forEach(function (c) { c.classList.remove('is-center'); });
        if (!isMobile()) {
          var centerIdx = Math.min(index + 1, cards.length - 1);
          cards[centerIdx].classList.add('is-center');
        }
        if (dotsWrap) {
          dotsWrap.querySelectorAll('.review-dot').forEach(function (d, i) {
            d.classList.toggle('active', i === index);
          });
        }
      }

      buildDots();
      goTo(0);
      setInterval(function () {
        if (!cards.length) return;
        var max = isMobile() ? cards.length - 1 : Math.max(0, cards.length - 3);
        goTo(index >= max ? 0 : index + 1);
      }, 4000);
      window.addEventListener('resize', function () {
        buildDots();
        goTo(0);
      });
    })();
  

(function () {
  window.toggleMenu = function () {
    var drawer = document.getElementById('mobileDrawer');
    var overlay = document.getElementById('overlay');
    if (drawer) drawer.classList.toggle('active');
    if (overlay) overlay.classList.toggle('active');
    document.body.style.overflow = drawer && drawer.classList.contains('active') ? 'hidden' : '';
  };

  document.querySelectorAll('[data-oxy-thumb]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('[data-oxy-thumb]').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      var img = document.getElementById('oxyMainImg');
      if (img) img.src = btn.getAttribute('data-oxy-thumb');
    });
  });

  var atc = document.getElementById('oxyAtcBtn');
  function getOxyVariant() {
    var el = document.getElementById('oxyVariantId');
    return el ? el.value : '';
  }

  if (atc) {
    atc.addEventListener('click', function () {
      if (typeof gAddToCart === 'function') {
        gAddToCart(getOxyVariant(), atc, 1);
      }
    });
  }
})();
</script>
