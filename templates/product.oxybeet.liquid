{% comment %}
  Alternate product template: oxybeet
  Appears in Admin > Product > Theme template as "oxybeet"
{% endcomment %}

<style>

    .oxy-page, .oxy-page * { box-sizing: border-box; margin: 0; padding: 0; }
    .oxy-page {
      font-family: Arial, Helvetica, sans-serif;
      color: #111;
      background: #fff;
      line-height: 1.45;
    }
    a { color: inherit; text-decoration: none; }
    button { font-family: inherit; cursor: pointer; }

    .announce {
      background: #000;
      color: #fff;
      text-align: center;
      font-size: 12px;
      letter-spacing: 0.04em;
      padding: 10px 14px;
    }

    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 24px;
      border-bottom: 1px solid #eee;
      position: sticky;
      top: 0;
      background: #fff;
      z-index: 20;
    }
    .header-left, .header-right {
      display: flex;
      align-items: center;
      gap: 22px;
      min-width: 180px;
    }
    .header-right { justify-content: flex-end; }
    .nav-link {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .logo {
      font-size: 20px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .logo-leaf {
      width: 14px;
      height: 14px;
      display: inline-block;
    }
    .icon-btn {
      width: 28px;
      height: 28px;
      border: 0;
      background: transparent;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .menu-btn { display: none; }

    .product-wrap {
      max-width: 1180px;
      margin: 0 auto;
      padding: 28px 24px 80px;
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 48px;
      align-items: start;
    }

    .gallery {
      display: grid;
      grid-template-columns: 72px 1fr;
      gap: 14px;
      position: sticky;
      top: 78px;
    }
    .thumbs {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .thumb,
    .main-media {
      background: #f3f3f3;
      border: 1px solid #e8e8e8;
    }
    .thumb {
      width: 72px;
      height: 72px;
      border-radius: 4px;
    }
    .thumb.active { border-color: #111; border-width: 2px; }
    .main-media-wrap { position: relative; }
    .main-media {
      width: 100%;
      aspect-ratio: 1 / 1;
      border-radius: 4px;
      position: relative;
    }
    .badge-stack {
      position: absolute;
      top: 14px;
      left: 14px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      z-index: 2;
    }
    .badge-best {
      width: 92px;
      height: 92px;
      border-radius: 50%;
      background: #5b3a2e;
      color: #fff;
      font-size: 10px;
      font-weight: 700;
      text-align: center;
      line-height: 1.25;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 10px;
      text-transform: uppercase;
    }
    .badge-organic {
      width: 58px;
      height: 58px;
      border-radius: 50%;
      background: #1f7a3a;
      color: #fff;
      font-size: 9px;
      font-weight: 700;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1.2;
      text-transform: uppercase;
    }
    .zoom-btn {
      position: absolute;
      right: 12px;
      bottom: 12px;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 0;
      background: #fff;
      box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }
    .dots {
      display: flex;
      justify-content: center;
      gap: 7px;
      margin-top: 12px;
    }
    .dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #d0d0d0;
    }
    .dot.active { background: #222; }

    .info { padding-top: 4px; }
    .title {
      font-size: 34px;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-bottom: 10px;
    }
    .rating {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 16px;
      font-size: 14px;
    }
    .stars { color: #f5b400; letter-spacing: 1px; font-size: 16px; }

    .price-row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 12px 14px;
      margin-bottom: 16px;
    }
    .compare {
      font-size: 22px;
      font-weight: 700;
      color: #222;
      text-decoration: line-through;
    }
    .sale {
      font-size: 24px;
      font-weight: 800;
      color: #111;
    }
    .save {
      font-size: 15px;
      font-weight: 800;
      color: #d10000;
    }

    .desc {
      font-size: 14px;
      color: #222;
      margin-bottom: 22px;
      max-width: 520px;
    }

    .btn-row { display: grid; gap: 10px; margin-bottom: 22px; }
    .btn {
      width: 100%;
      padding: 15px 18px;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      border-radius: 2px;
      cursor: pointer;
    }
    .btn-atc {
      background: #111;
      color: #fff;
      border: 1px solid #111;
    }

    .accordion {
      margin-top: 28px;
      border-top: 1px solid #ddd;
      text-align: left;
    }
    .acc-item { border-bottom: 1px solid #ddd; }
    .acc-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 16px 2px;
      border: 0;
      background: transparent;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #111;
      text-align: left;
    }
    .acc-left {
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }
    .acc-ico { font-size: 16px; line-height: 1; }
    .acc-chevron {
      width: 10px;
      height: 10px;
      border-right: 2px solid #111;
      border-bottom: 2px solid #111;
      transform: rotate(45deg);
      transition: transform 0.2s ease;
      flex-shrink: 0;
      margin-bottom: 3px;
    }
    .acc-item.open .acc-chevron {
      transform: rotate(-135deg);
      margin-bottom: 0;
      margin-top: 3px;
    }
    .acc-panel {
      display: none;
      padding: 0 2px 18px 28px;
      font-size: 13px;
      color: #333;
      line-height: 1.6;
    }
    .acc-item.open .acc-panel { display: block; }
    .acc-panel p { margin: 0 0 12px; }
    .acc-panel h4 {
      margin: 16px 0 8px;
      font-size: 13px;
      font-weight: 800;
      color: #111;
      letter-spacing: 0.02em;
    }
    .acc-panel h4:first-child { margin-top: 0; }
    .acc-panel ul {
      margin: 0 0 12px;
      padding-left: 18px;
    }
    .acc-panel li { margin-bottom: 6px; }
    .acc-panel .acc-lead {
      font-weight: 700;
      color: #111;
      margin-bottom: 14px;
    }
    .acc-panel .acc-block { margin-bottom: 14px; }
    .acc-panel .acc-block strong {
      display: block;
      margin-bottom: 4px;
      color: #111;
    }
    .acc-panel .acc-tip {
      margin-top: 12px;
      font-style: italic;
      color: #444;
    }
    .acc-panel .acc-qa { margin-bottom: 12px; }
    .acc-panel .acc-qa .prob { font-weight: 700; color: #111; margin-bottom: 2px; }
    .acc-panel .acc-qa .sol { color: #444; }

    .trust-section {
      max-width: 980px;
      margin: 10px auto 0;
      padding: 40px 24px 50px;
    }
    .trust-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 20px;
      align-items: start;
      justify-items: center;
    }
    .trust-item {
      text-align: center;
      max-width: 140px;
    }
    .trust-icon {
      width: 54px;
      height: 54px;
      margin: 0 auto 12px;
      color: #111;
    }
    .trust-icon svg {
      width: 100%;
      height: 100%;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.6;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .trust-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      line-height: 1.35;
    }

    .reviews-section {
      background: #e59188;
      padding: 54px 24px 64px;
    }
    .reviews-title {
      text-align: center;
      font-size: 28px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 36px;
      color: #111;
    }
    .reviews-carousel {
      max-width: 980px;
      margin: 0 auto;
      position: relative;
      overflow: hidden;
    }
    .reviews-track {
      display: flex;
      gap: 22px;
      transition: transform 0.45s ease;
      align-items: stretch;
    }
    .review-card {
      background: #fff;
      flex: 0 0 calc((100% - 44px) / 3);
      padding: 28px 22px 24px;
      text-align: center;
      box-shadow: 0 8px 24px rgba(0,0,0,0.12);
      min-height: 220px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .review-card.is-center {
      transform: scale(1.03);
      box-shadow: 0 14px 34px rgba(0,0,0,0.18);
    }
    .review-stars {
      color: #111;
      letter-spacing: 2px;
      font-size: 14px;
      margin-bottom: 14px;
    }
    .review-text {
      font-size: 14px;
      line-height: 1.55;
      color: #111;
      margin-bottom: 18px;
    }
    .review-name {
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .review-city {
      font-size: 13px;
      color: #333;
    }
    .review-dots {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 28px;
    }
    .review-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      border: 0;
      background: rgba(0,0,0,0.25);
      padding: 0;
    }
    .review-dot.active {
      background: #111;
      width: 10px;
      height: 10px;
    }

    .text-image-section {
      background: #fff;
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      min-height: 520px;
      align-items: stretch;
    }
    .text-image-copy {
      padding: 72px 56px 72px 8%;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .text-image-copy h2 {
      font-size: clamp(26px, 3vw, 38px);
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      line-height: 1.2;
      margin-bottom: 28px;
      color: #111;
      max-width: 420px;
    }
    .text-image-copy p {
      font-size: 15px;
      line-height: 1.7;
      color: #222;
      margin-bottom: 18px;
      max-width: 460px;
    }
    .text-image-copy p:last-child { margin-bottom: 0; }
    .text-image-media {
      background: #f3f3f3;
      border-left: 1px solid #ececec;
      min-height: 420px;
      width: 100%;
      height: 100%;
    }

    .faq-section,
    .written-reviews {
      max-width: 900px;
      margin: 0 auto;
      padding: 64px 24px;
    }
    .faq-section h2,
    .written-reviews h2 {
      text-align: center;
      font-size: 28px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 36px;
      color: #111;
    }
    .faq-list { border-top: 1px solid #ddd; }
    .faq-item { border-bottom: 1px solid #ddd; }
    .faq-q {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 18px 4px;
      border: 0;
      background: transparent;
      text-align: left;
      font-size: 15px;
      font-weight: 700;
      color: #111;
    }
    .faq-chevron {
      width: 10px;
      height: 10px;
      border-right: 2px solid #111;
      border-bottom: 2px solid #111;
      transform: rotate(45deg);
      transition: transform 0.2s ease;
      flex-shrink: 0;
      margin-bottom: 3px;
    }
    .faq-item.open .faq-chevron {
      transform: rotate(-135deg);
      margin-bottom: 0;
      margin-top: 3px;
    }
    .faq-a {
      display: none;
      padding: 0 4px 18px;
      font-size: 14px;
      line-height: 1.65;
      color: #333;
    }
    .faq-item.open .faq-a { display: block; }

    .review-summary {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 18px;
      margin-bottom: 32px;
      flex-wrap: wrap;
    }
    .review-score {
      font-size: 48px;
      font-weight: 800;
      line-height: 1;
    }
    .review-summary-meta {
      text-align: left;
    }
    .review-summary-stars {
      color: #111;
      letter-spacing: 2px;
      font-size: 16px;
      margin-bottom: 4px;
    }
    .review-summary-count {
      font-size: 13px;
      color: #555;
    }
    .written-list {
      display: grid;
      gap: 16px;
    }
    .written-card {
      border: 1px solid #e5e5e5;
      padding: 22px 20px;
      background: #fff;
    }
    .written-top {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: baseline;
      margin-bottom: 8px;
      flex-wrap: wrap;
    }
    .written-name {
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .written-date {
      font-size: 12px;
      color: #777;
    }
    .written-stars {
      color: #111;
      letter-spacing: 1px;
      font-size: 13px;
      margin-bottom: 10px;
    }
    .written-body {
      font-size: 14px;
      line-height: 1.6;
      color: #222;
    }

    .wa {
      position: fixed;
      right: 18px;
      bottom: 18px;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: #25d366;
      color: #fff;
      border: 0;
      box-shadow: 0 6px 18px rgba(0,0,0,0.2);
      z-index: 50;
      font-size: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    @media (max-width: 900px) {
      .header { padding: 12px 14px; }
      .header-left .nav-link,
      .header-right .nav-contact,
      .header-right .nav-blog { display: none; }
      .menu-btn { display: inline-flex; }
      .header-left, .header-right { min-width: auto; gap: 12px; }
      .logo { font-size: 16px; position: absolute; left: 50%; transform: translateX(-50%); }

      .product-wrap {
        grid-template-columns: 1fr;
        gap: 18px;
        padding: 0 0 90px;
      }
      .gallery {
        grid-template-columns: 1fr;
        gap: 0;
      }
      .thumbs { display: none; }
      .main-media {
        border-radius: 0;
        border-left: 0;
        border-right: 0;
      }
      .info {
        padding: 8px 16px 0;
        text-align: center;
      }
      .title { font-size: 28px; }
      .rating, .price-row, .desc { justify-content: center; }
      .desc { margin-left: auto; margin-right: auto; }
      .price-row { justify-content: center; }
      .compare { font-size: 20px; }
      .sale { font-size: 22px; }
      .btn-row, .accordion {
        max-width: 420px;
        margin-left: auto;
        margin-right: auto;
      }
      .accordion { text-align: left; }
      .gallery { position: static; }

      .trust-section { padding: 28px 18px 36px; }
      .trust-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 24px 18px;
        max-width: 420px;
        margin: 0 auto;
      }
      .trust-item {
        flex: 0 0 calc(33.33% - 14px);
        max-width: 120px;
      }
      .trust-icon { width: 46px; height: 46px; }
      .trust-label { font-size: 10px; }

      .reviews-section { padding: 40px 16px 56px; }
      .reviews-title { font-size: 22px; margin-bottom: 24px; }
      .review-card {
        flex: 0 0 100%;
        min-height: 200px;
        transform: none !important;
      }
      .reviews-track { gap: 0; }

      .text-image-section {
        grid-template-columns: 1fr;
      }
      .text-image-media {
        order: -1;
        min-height: 280px;
        border-left: 0;
        border-bottom: 1px solid #ececec;
        aspect-ratio: 4 / 3;
      }
      .text-image-copy {
        padding: 36px 20px 48px;
        text-align: left;
      }
      .text-image-copy h2 {
        font-size: 24px;
        margin-bottom: 18px;
        max-width: none;
      }
      .text-image-copy p {
        font-size: 14px;
        max-width: none;
      }

      .faq-section,
      .written-reviews {
        padding: 44px 16px 52px;
      }
      .faq-section h2,
      .written-reviews h2 {
        font-size: 22px;
        margin-bottom: 24px;
      }
      .review-score { font-size: 40px; }
      .written-card { padding: 18px 16px; }
    }
  

/* Shopify product image support */
.oxy-page .thumb img,
.oxy-page .main-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.oxy-page .main-media.has-image { background: #fff; }
#globalStickyAtc { display: none !important; }

/* Match homepage / product page header */
.oxy-page {
  --primary: #1a3b2b;
  --secondary: #7a1c1c;
  --background: #ffffff;
  --font-serif: 'Playfair Display', serif;
  --font-sans: 'Inter', sans-serif;
}
.oxy-page .announce,
.oxy-page > .header { display: none !important; }

.oxy-site-header {
  background-color: #ffffff;
  padding: 20px 5%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1px solid rgba(0, 33, 71, 0.1);
}
.oxy-site-header .logo {
  font-family: 'Playfair Display', serif;
  font-size: 28px;
  color: #1a3b2b;
  text-decoration: none;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-weight: 700;
  letter-spacing: 2px;
}
.oxy-site-header nav a {
  text-decoration: none;
  color: #1a3b2b;
  font-weight: 600;
  font-size: 14px;
  margin-right: 25px;
  text-transform: uppercase;
  font-family: 'Inter', sans-serif;
}
.oxy-site-header .header-icons { display: flex; gap: 20px; align-items: center; }
.oxy-site-header .menu-toggle { display: none; flex-direction: column; gap: 5px; cursor: pointer; z-index: 1001; }
.oxy-site-header .menu-toggle span { display: block; width: 25px; height: 2px; background-color: #1a3b2b; }
.oxy-site-header .g-cart-count {
  font-size: 12px;
  font-weight: 700;
  color: #1a3b2b;
}

.oxy-drawer-overlay {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.5); z-index: 1999; display: none;
}
.oxy-drawer-overlay.active { display: block; }
.oxy-mobile-drawer {
  position: fixed; top: 0; left: -100%; width: 300px; height: 100%;
  background: #fff; z-index: 2000; transition: 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex; flex-direction: column; box-shadow: 10px 0 40px rgba(0,0,0,0.15);
}
.oxy-mobile-drawer.active { left: 0; }
.oxy-drawer-banner {
  background: #1a3b2b; padding: 40px 25px; color: #fff;
}
.oxy-drawer-banner h2 {
  font-family: 'Playfair Display', serif; font-size: 24px; margin: 0; letter-spacing: 1px;
}
.oxy-drawer-banner p { font-size: 13px; opacity: 0.8; margin-top: 5px; }
.oxy-drawer-nav { padding: 15px 0; display: flex; flex-direction: column; }
.oxy-drawer-link {
  display: flex; align-items: center; gap: 20px; padding: 14px 25px;
  text-decoration: none; color: #444; font-weight: 600; font-size: 15px;
}
.oxy-drawer-link svg { width: 22px; height: 22px; color: #666; }
.oxy-drawer-link.active { background: #e8f3f1; color: #1a3b2b; }
.oxy-drawer-divider { height: 1px; background: #eee; margin: 10px 0; }
.oxy-drawer-group-label {
  padding: 20px 25px 10px; font-size: 12px; text-transform: uppercase;
  letter-spacing: 1px; color: #999; font-weight: 700;
}

@media (max-width: 768px) {
  .oxy-site-header .menu-toggle { display: flex !important; }
  .oxy-site-header nav { display: none !important; }
  .oxy-site-header .logo { font-size: 18px; white-space: nowrap; }
  .oxy-site-header { padding: 12px 5%; }
}

/* Homepage-matching footer */
.oxy-footer {
  background-color: #1a3b2b;
  color: #fff;
  padding: 80px 5% 40px;
  font-family: 'Inter', Arial, Helvetica, sans-serif;
  box-sizing: border-box;
}
.oxy-footer *, .oxy-footer *::before, .oxy-footer *::after { box-sizing: border-box; }
.oxy-footer .footer-container {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1.5fr;
  gap: 60px;
}
.oxy-footer .footer-brand h2 {
  font-family: 'Playfair Display', serif;
  margin: 0 0 20px;
  font-size: 28px;
